  = [[{msg: "Name is required", severity: "error"}], [{msg: "Bad email", severity: "error"}], null]
> Rows[1].$errors(Qty), Rows[0].$errors(Qty)
  = [[{msg: "Qty must be positive", severity: "error"}], null]
> $hasErrors([Document.Name]), $hasErrors([Document.Memo])
