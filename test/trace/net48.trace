## scalars: types, changing/change, cancel, $$, lock
> create
  ev TDocument.construct(@~Document, "Document")
  ev TRoot.construct(@Root, "")
> load
  ev Model.load(@Root, null, false)
  $dirty → false
> Name = "New"
  ev Document.Name.changing(@Root.Document, "New", "Doc", "Name")
  ev Model.dirty.change(true, "Document.Name")
  ev Document.Name.change(@Root.Document, "New", "Doc", "Name")
  $dirty → true
> Name = "New" again
> Name = "forbidden" (changing → false)
  ev Document.Name.changing(@Root.Document, "forbidden", "New", "Name") → false
  = "New"
> Amount = "1 234,5"
  ev Document.Amount.changing(@Root.Document, 1234.5, 5, "Amount")
  ev Document.Amount.change(@Root.Document, 1234.5, 5, "Amount")
  = 1234.5
> Amount = "abc"
  ev Document.Amount.changing(@Root.Document, 0, 1234.5, "Amount")
  ev Document.Amount.change(@Root.Document, 0, 1234.5, "Amount")
  = 0
> Amount = null
  = 0
> Done = 1
  ev Document.Done.changing(@Root.Document, true, false, "Done")
  ev Document.Done.change(@Root.Document, true, false, "Done")
  = true
> Done = "false"
  ev Document.Done.changing(@Root.Document, false, true, "Done")
  ev Document.Done.change(@Root.Document, false, true, "Done")
  = false
> Name = 42
  ev Document.Name.changing(@Root.Document, "42", "New", "Name")
  ev Document.Name.change(@Root.Document, "42", "New", "Name")
  = "42"
> Date = new Date(2026, 0, 15)
  ev Document.Date.changing(@Root.Document, D2026-01-15T00:00:00, D2025-03-30T00:00:00, "Date")
  ev Document.Date.change(@Root.Document, D2026-01-15T00:00:00, D2025-03-30T00:00:00, "Date")
  = D2026-01-15T00:00:00
> Date = "2026-02-01T00:00:00"
  ev Document.Date.changing(@Root.Document, D2026-02-01T00:00:00, D2026-01-15T00:00:00, "Date")
  ev Document.Date.change(@Root.Document, D2026-02-01T00:00:00, D2026-01-15T00:00:00, "Date")
  = D2026-02-01T00:00:00
> $$Tab = "x"
  ev Document.$$Tab.changing(@Root.Document, "x", "", "$$Tab")
  ev Document.$$Tab.change(@Root.Document, "x", "", "$$Tab")
> $lockEvents; Name = "Locked"; $unlockEvents
  = true
> $id, $name, $isNew, $maxLength(Name), $maxLength(Amount)
  = [10, "Locked", false, 50, undefined]
> $root, $parent, $vm present
  = [true, true, true]
> add a property to an element after load
  throws TypeError: Cannot add property Extra, object is not extensible
> root.$setDirty(false)
  ev Model.dirty.change(false, undefined)
  $dirty → false
> data
  = TRoot {
      Document: TDocument {
        Id: 10
        Name: "Locked"
        Amount: 0
        Done: false
        Date: D2026-02-01T00:00:00
        $$Tab: "x"
      }
    }

## objects: assign element, null, plain object, $empty, $merge
> create
  ev TAgent.construct(@~Document.Agent, "Agent")
  ev TDocument.construct(@~Document, "Document")
  ev TAgentArray.construct(@~Agents)
  ev TAgent.construct(@~Agents[], "Agents[]")
  ev TAgent.construct(@~Agents[], "Agents[]")
  ev TRoot.construct(@Root, "")
> load
  ev Model.load(@Root, null, false)
  $dirty → false
> Agent = Agents[0]
  ev Document.Agent.changing(@Root.Document, @Root.Agents[0], @Root.Document.Agent, "Agent")
  ev Model.dirty.change(true, "Document.Agent.Id")
  ev Document.Agent.change(@Root.Document, @Root.Document.Agent, @Root.Document.Agent, "Agent")
  = [true, 6]
  $dirty → true
> Agent.Name = "Changed"; Agents[0].Name
  ev Document.Agent.Name.changing(@Root.Document.Agent, "Changed", "Six", "Name")
  ev Document.Agent.Name.change(@Root.Document.Agent, "Changed", "Six", "Name")
  = "Six"
> Agent = Agents[0] again (same Id)
  ev Document.Agent.changing(@Root.Document, @Root.Agents[0], @Root.Document.Agent, "Agent")
> Agent = null
  ev Document.Agent.changing(@Root.Document, null, @Root.Document.Agent, "Agent")
  ev Document.Agent.change(@Root.Document, @Root.Document.Agent, @Root.Document.Agent, "Agent")
  = [0, ""]
> Agent = {Id: 8, Name: "Plain"}
  ev Document.Agent.changing(@Root.Document, {Id: 8, Name: "Plain"}, @Root.Document.Agent, "Agent")
  ev Document.Agent.change(@Root.Document, @Root.Document.Agent, @Root.Document.Agent, "Agent")
> Agent.$empty()
  ev Document.Agent.change(@Root.Document, @Root.Document.Agent, @Root.Document.Agent, "Agent")
  = true
> Document.$merge({Id: 2, Agent: {Id: 9}, Memo: "m"})
  ev Document.change(@Root, @Root.Document, @Root.Document, "Document")
  = [true, "Document.Agent"]
> Document.$merge({Id: 2, Memo: "same id"})
> Agent.$set({Id: 10})
  ev Document.Agent.change(@Root.Document, @Root.Document.Agent, @Root.Document.Agent, "Agent")
> data
  = TRoot {
      Document: TDocument {
        Id: 2
        Agent: TAgent {
          Id: 10
          Name: ""
        }
        Memo: "same id"
      }
      Agents: [
        [0] TAgent {
          Id: 6
          Name: "Six"
        }
        [1] TAgent {
          Id: 7
          Name: "Seven"
        }
      ]
    }

