## $save: a new document
> create
  ev TAgent.construct(@~Document.Agent, "Agent")
  ev TRowArray.construct(@~Document.Rows)
  ev TRow.construct(@~Document.Rows[], "Rows[]")
  ev TRow.construct(@~Document.Rows[], "Rows[]")
  ev TDocument.construct(@~Document, "Document")
  ev TRoot.construct(@Root, "")
> mount A /_page/document/edit/new
  bus registerData(vm:A, {caller: null}) → null
  bus isModalRequery({url: "/_page/document/edit/new", result: false})
  ev Model.load(@Root, null, false)
  $dirty → false
> Document.Name = "Doc"
  ev Document.Name.changing(@Root.Document, "Doc", "", "Name")
  ev Model.dirty.change(true, "Document.Name")
  ev Document.Name.change(@Root.Document, "Doc", "", "Name")
  $dirty → true
> $save({ toast: "Saved" })
  bus closeAllPopups()
  ev Model.beforeSave(@Root)
  bus beginRequest("/_data/save")
  fetch POST /_data/save {"baseUrl":"/_page/document/edit/new","data":{"Document":{"Id":0,"Name":"Doc","Memo":"","Agent":{"Id":0,"Name":""},"Rows":[{"Id":1,"Qty":1},{"Id":2,"Qty":2}]}}} → 200 {"Document":{"Id":25,"Name":"Doc","Memo":"","Agent":{"Id":0,"Name":""},"Rows":[{"Id":1,"Qty":1},{"Id":2,"Qty":2}]}}
  = Promise
  bus endRequest("/_data/save")
  ev TRow.construct(@~Document.Rows[], "Rows[]")
  ev TRow.construct(@~Document.Rows[], "Rows[]")
  ev Model.saved(@Root)
  ev Model.dirty.change(false, undefined)
  bus setnewid({from: "", to: "25"})
  bus toast({text: "Saved", style: "success", time: undefined})
  resolved {Id: 25, Name: "Doc", Memo: "", Agent: {Id: 0, Name: ""}, Rows: [{Id: 1, Qty: 1}, {Id: 2, Qty: 2}]}
  $dirty → false
> $baseUrl, Document.$id, $isDirty
  = ["/_page/document/edit/25", 25, false]
> $save() not dirty
> data
  = TRoot {
      Document: TDocument {
        Id: 25
        Name: "Doc"
        Memo: ""
        Agent: TAgent {
          Id: 0
          Name: ""
        }
        Rows: [
          [0] TRow {
            Id: 1
            Qty: 1
          }
          [1] TRow {
            Id: 2
            Qty: 2
          }
        ]
      }
    }

