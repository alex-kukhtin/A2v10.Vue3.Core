> bus childrenSaved, another token
  bus childrenSaved({token: "other", toast: "No"})
> bus childrenSaved, the page's token
  bus childrenSaved({token: "1630", update: @Root.Documents, toast: "Saved", id: 2})
    bus toast({text: "Saved", style: "success", time: undefined})
    bus closeAllPopups()
    bus beginRequest("/_data/reload")
    fetch POST /_data/reload {"baseUrl":"/_page/document/index/0?pageSize=20&dir=asc&order=Name"} → 200 {"Documents":[{"Id":1,"Name":"One"},{"Id":2,"Name":"Two"}],"$ModelInfo":{"Documents":{"PageSize":20,"Offset":0,"SortOrder":"Name","SortDir":"asc"}}}
  bus endRequest("/_data/reload")
  bus pageReloaded("/_page/document/index/0?pageSize=20&dir=asc&order=Name")
  ev TDocument.construct(@~Documents[], "Documents[]")
  ev TDocument.construct(@~Documents[], "Documents[]")
  bus isModalRequery({url: "/_page/document/index/0", result: false})
  ev Model.load(@Root, null, false)
> bus globalPeriodChanged; globalAppEvent; signalEvent
  bus globalPeriodChanged({From: 1})
    ev GlobalPeriod.change(@Root, {From: 1})
  bus globalAppEvent({event: "app.ev", data: 1})
    ev app.ev(1)
  bus signalEvent({event: "sig.ev", data: 2})
    ev Signal.sig.ev(2)
> bus invokeTest
  bus invokeTest({target: "controller", action: "eval", path: "Documents.length"})
  = 2
> $emit("cwChange", Documents)
  bus closeAllPopups()
  bus beginRequest("/_data/reload")
  fetch POST /_data/reload {"baseUrl":"/_page/document/index/0?pageSize=20&dir=asc&order=Name"} → 200 {"Documents":[{"Id":1,"Name":"One"},{"Id":2,"Name":"Two"}],"$ModelInfo":{"Documents":{"PageSize":20,"Offset":0,"SortOrder":"Name","SortDir":"asc"}}}
  bus endRequest("/_data/reload")
  bus pageReloaded("/_page/document/index/0?pageSize=20&dir=asc&order=Name")
  ev TDocument.construct(@~Documents[], "Documents[]")
  ev TDocument.construct(@~Documents[], "Documents[]")
  bus isModalRequery({url: "/_page/document/index/0", result: false})
  ev Model.load(@Root, null, false)
> $destroy()
  ev Model.unload(@Root)
  bus registerData(null)
  html.removePrintFrame()
> listeners
  = {}
> bus signalEvent; globalAppEvent
  bus signalEvent({event: "sig.ev", data: 3})
  bus globalAppEvent({event: "app.ev", data: 4})

