> create
  ev TAgent.construct(@~Agent, "Agent")
  ev TRoot.construct(@Root, "")
> mount D /_dialog/agent/edit/7
  bus registerData(vm:D, {caller: null}) → vm:A
  bus isModalRequery({url: "/_dialog/agent/edit/7", result: false})
  [D] ev Model.load(@Root, @Root, false)
> D.$caller
  = vm:A
> D.__parseControllerAttributes("{'saveEvent':'agent.saved','alwaysOk':true,'placement':'right'}")
  = {alwaysOk: true, placement: "right"}
> D: Agent.Name = "New"; $save()
  [D] ev Agent.Name.changing(@Root.Agent, "New", "Agent", "Name")
  [D] ev Model.dirty.change(true, "Agent.Name")
  [D] ev Agent.Name.change(@Root.Agent, "New", "Agent", "Name")
  bus closeAllPopups()
  [D] ev Model.beforeSave(@Root)
  bus beginRequest("/_data/save")
  fetch POST /_data/save {"baseUrl":"/_dialog/agent/edit/7","data":{"Agent":{"Id":7,"Name":"New"}}} → 200 {"Agent":{"Id":7,"Name":"New"}}
  = Promise
  bus endRequest("/_data/save")
  [D] ev Model.saved(@Root)
  [A] ev agent.saved(@Root)
  [D] ev Model.dirty.change(false, undefined)
  resolved {Id: 7, Name: "New"}
> D: $emitSaveEvent(); $emitCaller("x.y", 1, 2)
  [A] ev agent.saved(@Root)
  [A] ev x.y(1, 2)
> D: $dirtyCaller(); A.$isDirty
  [A] ev Model.dirty.change(true, undefined)
  = true
> D: $saveCaller()
  bus closeAllPopups()
  [A] ev Model.beforeSave(@Root)
  bus beginRequest("/_data/save")
  fetch POST /_data/save {"baseUrl":"/_page/document/edit/5","data":{"Document":{"Id":5,"Name":"Doc","Memo":"","Agent":{"Id":0,"Name":""},"Rows":[{"Id":1,"Qty":1},{"Id":2,"Qty":2}]}}} → 200 {"Document":{"Id":5,"Name":"Doc","Memo":"","Agent":{"Id":0,"Name":""},"Rows":[{"Id":1,"Qty":1},{"Id":2,"Qty":2}]}}
  = Promise
  bus endRequest("/_data/save")
  [A] ev TRow.construct(@~Document.Rows[], "Rows[]")
  [A] ev TRow.construct(@~Document.Rows[], "Rows[]")
  [A] ev Model.saved(@Root)
  [A] ev Model.dirty.change(false, undefined)
  resolved {Id: 5, Name: "Doc", Memo: "", Agent: {Id: 0, Name: ""}, Rows: [{Id: 1, Qty: 1}, {Id: 2, Qty: 2}]}
> D: $emitGlobal("g.ev", 1); $emitParentTab("p.ev", 2)
  bus globalAppEvent({event: "g.ev", data: 1})
    [A] ev g.ev(1)
    [D] ev g.ev(1)
  bus toParentTab({event: "p.ev", source: vm:D, data: 2})
> A: $emitCaller("x") with no caller
  console.error "There is no caller here"
> A.$destroy(); D: $saveCaller(), $emitCaller("x")
  [A] ev Model.unload(@Root)
  bus registerData(null)
  html.removePrintFrame()
  = [null, undefined]

