{
  // tsc checks and emits ESM + .d.ts + maps into build/; rollup bundles build/ into dist/ (rollup.config.mjs).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // No "DOM": the core runs in a browser, in Node and in Jint. The host globals it may use are
    // declared one by one in src/ambient.d.ts; any other (window, document, alert) does not compile.
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noEmitOnError": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "rootDir": "src",
    "outDir": "build"
  },
  "include": ["src"]
}
