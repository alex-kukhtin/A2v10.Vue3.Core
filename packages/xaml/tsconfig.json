{
  // tsc checks and emits ESM + .d.ts + maps into build/; rollup bundles build/ into dist/ (rollup.config.mjs).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // The components live in the browser: DOM is their host.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "noEmitOnError": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "rootDir": "src",
    "outDir": "build"
  },
  "include": ["src"]
}
